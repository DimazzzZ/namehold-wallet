# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
src-tauri/target/

# Tauri generated
src-tauri/gen/

# Database
*.db
*.db-wal
*.db-shm

# Environment
.env
.env.local
.env.*.local

# Secrets & credentials (defence-in-depth — no existing files match these,
# but common patterns are excluded so an accidentally-dropped key file
# doesn't get committed).
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
secrets.*
credentials.*

# IDE
.vscode/
.idea/
.mimocode/
.clinerules/
.cline/
.github/copilot-instructions.md
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
# CI runner log dumps are often saved as .txt so *.log alone doesn't catch
# them. `job-logs.txt` was accidentally committed once (later purged from
# history) — keep any future dump out of the tree.
job-logs*.txt
*-ci-logs.txt

# Testing
coverage/
.qa/

# Rust
**/*.rs.bk

# Bundle artifacts (reproducible via `pnpm tauri build`)
src-tauri/target/release/bundle/

# Build artifacts
tsconfig.tsbuildinfo
www.namebase.io.har
CLAUDE.md
