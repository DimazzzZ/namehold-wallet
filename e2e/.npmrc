# E2E test tooling only — never shipped to users. Disable pnpm's default
# minimum-release-age supply-chain check for this dir so a freshly-published
# transitive dep (e.g. jszip via webdriverio's driver bundle) doesn't block
# CI. The check still applies to the app's own dependency graph at the repo
# root, which is what actually ships.
minimum-release-age=0
