{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@wdio/mocha-framework"],
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["specs/**/*.ts", "wdio.conf.ts"]
}
