{
  "productName": "Namehold",
  "version": "0.3.0",
  "identifier": "org.zhavoronkov.nameholdwallet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node src-tauri/build-sidecar.mjs --debug && pnpm dev",
    "beforeBuildCommand": "pnpm build && node src-tauri/build-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Namehold - your HNS network wallet",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://e.hnsfans.com https://sunset.namebase.io http://127.0.0.1:* http://localhost:*; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/namehold-syncd"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQUUwMkY4NzU3RDE2MDkKUldRSkZuMTErQUt1TStWUjF5VExIS1hRUGM4d0taMDJZRmFzb250TlA4WHVhY1U0cTNkWDJZZGkK",
      "endpoints": [
        "https://github.com/DimazzzZ/namehold-wallet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
